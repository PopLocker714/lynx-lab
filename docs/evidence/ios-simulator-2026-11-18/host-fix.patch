diff --git a/ios/SparklingGo/SparklingGo/FullWindowSparklingViewController.swift b/ios/SparklingGo/SparklingGo/FullWindowSparklingViewController.swift
new file mode 100644
index 0000000..c104713
--- /dev/null
+++ b/ios/SparklingGo/SparklingGo/FullWindowSparklingViewController.swift
@@ -0,0 +1,163 @@
+import Sparkling
+import UIKit
+
+/// This probe hosts one full-window Lynx view. Embedded views need their own geometry contract.
+/// Sparkling delivers these callbacks on main; its delegate protocol lacks actor annotations.
+@MainActor
+final class FullWindowSparklingViewController: UIViewController, @MainActor SPKContainerLifecycleProtocol {
+    private let scheme: String
+    private let spkContext: SPKContext
+    private let initialFrame: CGRect
+    private let container = SPKContainerView()
+    private var keyboardProbe: NativeKeyboardProbe?
+    private var hasStartedLoading = false
+    private var hasAppeared = false
+    private var contentAppeared = false
+    private var isDisposed = false
+    private var isApplicationActive = UIApplication.shared.applicationState == .active
+
+    init(scheme: String, context: SPKContext, frame: CGRect) {
+        self.scheme = scheme
+        self.spkContext = context
+        self.initialFrame = frame
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("Use init(scheme:context:frame:)")
+    }
+
+    override var prefersStatusBarHidden: Bool { true }
+
+    override func loadView() {
+        view = UIView(frame: initialFrame)
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .black
+        container.frame = view.bounds
+        container.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        container.sparkContentMode = .SPKContainerViewContentModeFitSize
+        container.containerLifecycleDelegate = self
+        view.addSubview(container)
+        keyboardProbe = NativeKeyboardProbe.installIfRequested(in: self)
+
+        let center = NotificationCenter.default
+        center.addObserver(self, selector: #selector(applicationDidBecomeActive),
+                           name: UIApplication.didBecomeActiveNotification, object: nil)
+        center.addObserver(self, selector: #selector(applicationWillResignActive),
+                           name: UIApplication.willResignActiveNotification, object: nil)
+    }
+
+    override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        loadAfterLayoutIfReady()
+    }
+
+    private func loadAfterLayoutIfReady() {
+        guard !hasStartedLoading, !isDisposed,
+              let window = view.window, !window.isHidden,
+              !view.bounds.isEmpty else {
+            return
+        }
+
+        // SPKViewController starts loading in viewDidLoad, before window attachment.
+        // At this boundary the full-window geometry exists, so the package's load hook
+        // can seed the owning LynxView's globalProps before its first MTS render.
+        hasStartedLoading = true
+        container.frame = view.bounds
+        container.layoutIfNeeded()
+        container.load(withURL: scheme, spkContext)
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        hasAppeared = true
+        navigationController?.setNavigationBarHidden(true, animated: false)
+        view.layoutIfNeeded()
+        loadAfterLayoutIfReady()
+        updateContentVisibility()
+    }
+
+    override func viewDidDisappear(_ animated: Bool) {
+        super.viewDidDisappear(animated)
+        hasAppeared = false
+        updateContentVisibility()
+        if isMovingFromParent || isBeingDismissed || navigationController?.isBeingDismissed == true {
+            dispose()
+        }
+    }
+
+    @objc private func applicationDidBecomeActive() {
+        isApplicationActive = true
+        updateContentVisibility()
+    }
+
+    @objc private func applicationWillResignActive() {
+        isApplicationActive = false
+        setContentVisible(false)
+    }
+
+    private func updateContentVisibility() {
+        let ready = container.kitView?.loadState == .SPKLoadStateSucceed
+        setContentVisible(hasAppeared && ready && !isDisposed && isApplicationActive)
+    }
+
+    private func setContentVisible(_ visible: Bool) {
+        guard contentAppeared != visible else { return }
+        contentAppeared = visible
+        container.hybridAppear = visible
+        container.hybridInBackground = !visible
+        if visible {
+            container.handleViewDidAppear()
+        } else {
+            container.handleViewDidDisappear()
+        }
+    }
+
+    func dispose() {
+        guard !isDisposed else { return }
+        isDisposed = true
+        setContentVisible(false)
+        NotificationCenter.default.removeObserver(self)
+        keyboardProbe?.detach()
+        keyboardProbe = nil
+        if hasStartedLoading {
+            container.kitView?.onVCWillDestory?()
+        }
+    }
+
+    deinit {
+        NotificationCenter.default.removeObserver(self)
+    }
+
+    func container(_ container: SPKContainerProtocol, didFinishLoadWithURL url: URL?) {
+        updateContentVisibility()
+        spkContext.containerLifecycleDelegate?.container?(container, didFinishLoadWithURL: url)
+    }
+
+    func container(_ container: SPKContainerProtocol, didLoadFailedWithURL url: URL?, error: Error?) {
+        spkContext.containerLifecycleDelegate?.container?(container, didLoadFailedWithURL: url, error: error)
+    }
+
+    func containerWillStartLoading(_ container: SPKContainerProtocol) {
+        spkContext.containerLifecycleDelegate?.containerWillStartLoading?(container)
+    }
+
+    func containerDidStartLoading(_ container: SPKContainerProtocol) {
+        spkContext.containerLifecycleDelegate?.containerDidStartLoading?(container)
+    }
+
+    func containerDidConstructJSRuntime(_ container: SPKContainerProtocol) {
+        spkContext.containerLifecycleDelegate?.containerDidConstructJSRuntime?(container)
+    }
+
+    func containerDidFirstScreen(_ container: SPKContainerProtocol) {
+        spkContext.containerLifecycleDelegate?.containerDidFirstScreen?(container)
+    }
+
+    func container(_ container: SPKContainerProtocol, didReceivePerformance perfDict: [AnyHashable: Any]?) {
+        spkContext.containerLifecycleDelegate?.container?(container, didReceivePerformance: perfDict)
+    }
+}
